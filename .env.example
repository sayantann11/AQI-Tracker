# ==============================================================================
# AirScope India - Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or API keys to version control.
# ==============================================================================

# Data Source APIs (Free developer registration required)
# 1. Government of India Open Data Portal (CPCB Dataset):
#    Register at: https://data.gov.in/ (Get API key under user profile)
DATA_GOV_IN_API_KEY=

# 2. OpenAQ v3 API (Fallback provider):
#    Register at: https://openaq.org/ (API key required for v3)
OPENAQ_API_KEY=

# Base URL for the Edge API Proxy (Cloudflare Worker or Next.js route handler)
# In development, leave blank or set to empty string to use local API proxy routes.
# In production on Render static site, set this to your free Cloudflare Worker URL, e.g.:
# NEXT_PUBLIC_API_PROXY_URL=https://airscope-proxy.your-account.workers.dev
NEXT_PUBLIC_API_PROXY_URL=

# Static Export flag for Render Static Site
# Set to 'true' during Render static site build (e.g. STATIC_EXPORT=true npm run build)
STATIC_EXPORT=false

# Feature Flags & Monetization
# Set to 'true' once Google AdSense or ad partner account is approved
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Analytics (Optional, Privacy-compliant)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Base Site URL for canonical links and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://airscope-india.onrender.com
