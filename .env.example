# AirScope India - environment template. Copy to .env.local for local dev. Never commit real keys.

# 1) Official CPCB feed (free): https://data.gov.in -> My Account -> API key
DATA_GOV_IN_API_KEY=

# 2) OpenAQ v3 backup feed (free, 60 req/min): https://explore.openaq.org/register
OPENAQ_API_KEY=

# Public site URL (set once you have a custom domain; otherwise Render's URL is used automatically)
NEXT_PUBLIC_SITE_URL=

# Contact email shown on policy pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Ads: only turn on AFTER Google AdSense approves the site
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Dev only: show sample fixtures when no key is set (never enable on production)
ALLOW_FIXTURES=false
